PORT=5000
MONGODB_URI=mongodb://localhost:27017/ecommerce
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Resend HTTP API (used for all outbound email - OTPs & admin alerts). Falls
# back to console logging (mock mode) if blank.
RESEND_API_KEY=
EMAIL_FROM="Khan's Fashion <onboarding@resend.dev>"

# Cloudinary credentials (optional, will use local upload fallback if blank)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
