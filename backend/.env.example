PORT=5000
MONGODB_URI=mongodb://localhost:27017/ecommerce
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Legacy secret used to verify tokens in the reviews route (utils/auth.js uses
# JWT_ACCESS_SECRET instead) - set this to the same value as JWT_ACCESS_SECRET
JWT_SECRET=your_jwt_access_secret_here

# Resend HTTP API (optional, preferred in production - e.g. Render - since it
# is not blocked by outbound SMTP port restrictions). Falls back to SMTP below
# if blank, and further falls back to console logging (mock mode) if neither
# is configured.
RESEND_API_KEY=
EMAIL_FROM="Khan's Fashion <onboarding@resend.dev>"

# Nodemailer SMTP settings (optional, used if RESEND_API_KEY is blank)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Cloudinary credentials (optional, will use local upload fallback if blank)
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
